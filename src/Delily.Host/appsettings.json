{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Delily": {
    "Smtp": {
      "Hostname": "localhost",
      "InboundPort": 25,
      "SubmissionPort": 587,
      "SubmissionsPort": 465,
      "MaxMessageSizeBytes": 26214400,
      "MaxRecipients": 100,
      "MaxConnections": 200,
      "MaxConnectionsPerIp": 20,
      "CommandTimeoutSeconds": 300,
      "DataTimeoutSeconds": 600,
      "EnableStartTls": true
    },
    "Imap": {
      "Hostname": "localhost",
      "ImapPort": 143,
      "ImapsPort": 993,
      "MaxLiteralBytes": 26214400,
      "IdleTimeoutSeconds": 1800
    },
    "Storage": {
      "BlobPath": "data/blobs",
      "MaxBlobSizeBytes": 52428800
    },
    "Queue": {
      "BatchSize": 50,
      "VisibilityTimeoutSeconds": 300,
      "MaxAttempts": 20,
      "InitialRetryDelaySeconds": 300
    },
    "Auth": {
      "RequireTls": true,
      "MaxFailedAttempts": 5,
      "LockoutSeconds": 900,
      "AllowedMechanisms": [ "SCRAM-SHA-256", "PLAIN" ]
    },
    "Tls": {
      "Enabled": false,
      "CertificatePath": "",
      "CertificatePassword": "",
      "MinimumProtocol": "Tls12"
    },
    "Http": {
      "MaxRequestBytes": 10485760,
      "MaxRecipients": 100,
      "MaxAttachments": 20,
      "MaxAttachmentBytes": 10485760,
      "IdempotencyWindowHours": 24,
      "RequireIdempotencyKey": true,
      "WebhookTimeoutSeconds": 10
    },
    "OpenTelemetry": {
      "Enabled": false
    }
  },
  "AllowedHosts": "*"
}
